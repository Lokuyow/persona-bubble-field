{
	"name": "persona-bubble-field",
	"private": true,
	"version": "0.0.1",
	"engines": {
		"node": ">=24.19.0 <25"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:host": "vite dev --host",
		"build": "vite build",
		"build:pages": "node scripts/build-pages.mjs",
		"characters:images": "node scripts/convert-character-images.mjs",
		"preview": "vite preview",
		"test": "vitest run",
		"postinstall": "patch-package --error-on-fail",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"validate": "npm test && npm run check && npm run build:pages && git diff --check",
		"deploy": "gh workflow run deploy-pages.yml --ref main"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"fake-indexeddb": "6.2.5",
		"mock-socket": "9.3.1",
		"patch-package": "8.0.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"sharp": "^0.35.4",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"idb": "^8.0.3",
		"nostr-tools": "^2.25.0",
		"rx-nostr": "3.7.5",
		"rxjs": "^7.8.2"
	}
}
