{
	"name": "persona-bubble-field",
	"private": true,
	"version": "0.0.1",
	"engines": {
		"node": ">=24.19.0 <25"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:death": "vite dev --mode death --port 5174 --strictPort",
		"dev:clear": "vite dev --mode clear --port 5175 --strictPort",
		"dev:host": "vite dev --host",
		"build": "vite build",
		"build:pages": "node scripts/build-pages.mjs",
		"characters:images": "node scripts/convert-character-images.mjs",
		"field-objects:images": "node scripts/convert-field-object-images.mjs",
		"preview": "vite preview",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:agent": "playwright test --reporter=dot",
		"operator:cooperation-defection:start": "tsx scripts/operator-cooperation-defection-start.ts",
		"operator:cooperation-defection:publish": "tsx scripts/operator-cooperation-defection-start.ts --publish",
		"operator:typecheck": "tsc -p tsconfig.operator.json --noEmit",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"validate": "npm run operator:typecheck && npm test && npm run check && npm run build:pages && git diff --check",
		"deploy": "gh workflow run deploy-pages.yml --ref main"
	},
	"devDependencies": {
		"@iconify-json/tabler": "^1.2.38",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/dom-chromium-ai": "^0.0.17",
		"@types/node": "^24.0.0",
		"fake-indexeddb": "6.2.5",
		"mock-socket": "9.3.1",
		"sharp": "^0.35.4",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tsx": "4.23.13",
		"typescript": "^6.0.3",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@noble/hashes": "^2.0.1",
		"@scure/bip32": "2.4.0",
		"@scure/bip39": "2.4.0",
		"bits-ui": "^2.19.0",
		"idb": "^8.0.3",
		"nostr-tools": "^2.25.0",
		"rx-nostr": "3.7.6",
		"rxjs": "^7.8.2"
	}
}
